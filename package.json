{
  "name": "scribo",
  "productName": "Scribo",
  "version": "1.1.1",
  "description": "PDF-Editor für handschriftliche Notizen – druckempfindliche Tinte, Formerkennung, Stifttasten.",
  "author": {
    "name": "Marco Keller",
    "email": "marco.p.keller@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "test:e2e": "node tests/e2e/electron.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sample": "node scripts/make-sample.mjs",
    "build:web": "vite build --base=./",
    "pretest": "node scripts/prepare-assets.mjs",
    "test:e2e:browser": "node tests/e2e/browser.mjs",
    "test:stress": "node tests/e2e/stress.mjs"
  },
  "devDependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/source-serif-4": "^0.4.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "lucide": "^1.59.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://marco-p-keller.github.io/scribo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marco-P-Keller/scribo.git"
  },
  "bugs": {
    "url": "https://github.com/Marco-P-Keller/scribo/issues"
  }
}
